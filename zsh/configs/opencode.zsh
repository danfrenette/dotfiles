# ==============================================================================
# OpenCode Development Environment
# ==============================================================================
# Aliases for dev-opencode - local OpenCode development runner
# ==============================================================================

# Main command aliases
alias ocode='dev-opencode'
alias oc='dev-opencode'

# Mode shortcuts
alias dev='dev-opencode dev'       # Start CLI dev mode (TUI)
alias devw='dev-opencode web-fg'   # Start web dev (foreground)
alias odev='dev-opencode dev'      # Start CLI dev mode
alias oweb='dev-opencode web'      # Start web dev (background)
alias owf='dev-opencode web-fg'    # Start web dev (foreground)
alias ostatus='dev-opencode status' # Check running processes
alias ostop='dev-opencode stop'    # Stop all processes
