Pry.editor = "nvim"

# Pretty print objects with awesome_print if available
begin
  require "awesome_print"
  Pry.print = proc { |output, value| output.puts value.ai }
rescue LoadError
  # awesome_print not installed, use default
end

# Paste from clipboard (macOS)
def paste
  IO.popen("pbpaste", "r").read
end

# Copy to clipboard: pbcopy or pbcopy(value) or pbcopy(pretty: true)
def copy(value, pretty: false)
  text = if pretty
    case value
    when String then value
    when Hash, Array
      require "json"
      JSON.pretty_generate(value)
    else
      require "pp"
      PP.pp(value, +"")
    end
  else
    value.inspect
  end

  IO.popen("pbcopy", "w") { |io| io.write(text) }
  puts "Copied #{text.length} chars to clipboard"
  nil
end
