require "irb/completion"

IRB.conf[:SAVE_HISTORY] = 1000
IRB.conf[:HISTORY_FILE] = "#{ENV['HOME']}/.irb_history"
IRB.conf[:AUTO_INDENT] = true
IRB.conf[:USE_AUTOCOMPLETE] = true

# Pretty print objects with awesome_print if available
begin
  require "awesome_print"
  AwesomePrint.irb!
rescue LoadError
  # awesome_print not installed, use default
end

# Paste from clipboard (macOS)
def paste
  IO.popen("pbpaste", "r").read
end

# Clear the screen
def clear
  system("clear")
end

# List methods which aren't in superclass (from r00k)
class Object
  def local_methods(obj = self)
    (obj.methods - obj.class.superclass.instance_methods).sort
  end
end
