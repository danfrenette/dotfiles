#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "skill_installer"
require "reporters/console_reporter"

dry_run = ARGV.include?("--dry-run") || ARGV.include?("-n")

reporter = Reporters::ConsoleReporter.new
SkillInstaller.new(dry_run: dry_run, reporter: reporter).install
