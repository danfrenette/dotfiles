#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "installer"
require "setup_options"

dry_run = ARGV.include?("--dry-run") || ARGV.include?("-n")

exit Installer.new(options: SetupOptions.new(skills_only: true, dry_run: dry_run)).install
